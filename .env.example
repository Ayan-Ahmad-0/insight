SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_ANON_KEY=your-supabase-publishable-key
SEED_PASSWORD=change-me-dev-only

# Only needed for legacy HS256-signed Supabase JWTs; this is not the JWKS URL.
SUPABASE_JWT_SECRET=

# Local web origins, comma-separated. Set the deployed frontend origin in Render.
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
DB_POOL_MAX=5

# Gemini analyst
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_ENABLED=true
AI_DEFAULT_DAILY_BUDGET_USD=0.50
AI_MAX_TOOL_ROUNDS=4
PRICE_IN_PER_M=0.25
PRICE_OUT_PER_M=1.50

# Analyst evaluation script (optional; API_URL defaults to localhost:8765)
API_URL=http://localhost:8765
EVAL_EMAIL_ACTIVE=user1@example.test
EVAL_EMAIL_CANCELED=user2@example.test
EVAL_PAUSE=4

# Configure this as a GitHub Actions repository variable, not a local .env value:
ISOLATION_DATABASE_URL=postgresql://postgres:ci@localhost:5432/insight
